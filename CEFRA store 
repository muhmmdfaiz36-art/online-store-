<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>CessaShop - Online Shop</title>

<style>
*{
    box-sizing:border-box;
    margin:0;
    padding:0;
}

body{
    font-family:Arial,sans-serif;
    background:#f5f6fa;
    color:#222;
}

/* NAVBAR */
header{
    background:#111827;
    color:white;
    position:sticky;
    top:0;
    z-index:100;
}

.nav{
    max-width:1150px;
    margin:auto;
    padding:15px 20px;
    display:flex;
    align-items:center;
    gap:20px;
}

.logo{
    font-size:23px;
    font-weight:bold;
}

.search{
    flex:1;
    max-width:450px;
    padding:11px 17px;
    border:0;
    border-radius:25px;
    outline:none;
}

.cart-button{
    border:0;
    background:none;
    color:white;
    cursor:pointer;
    font-size:15px;
}

/* HERO */
.hero{
    max-width:1150px;
    margin:25px auto;
    padding:45px 30px;
    border-radius:20px;
    background:linear-gradient(135deg,#7c3aed,#ec4899);
    color:white;

    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:25px;
}

.hero h1{
    font-size:42px;
    margin-bottom:12px;
}

.hero p{
    line-height:1.6;
}

.hero img{
    width:300px;
    height:200px;
    object-fit:cover;
    border-radius:18px;
}

/* CONTAINER */
.container{
    max-width:1150px;
    margin:30px auto;
    padding:0 20px;
}

.section-title{
    margin-bottom:18px;
}

/* CATEGORY */
.categories{
    display:flex;
    gap:10px;
    overflow-x:auto;
    margin-bottom:30px;
}

.category{
    border:0;
    background:white;
    padding:10px 18px;
    border-radius:25px;
    cursor:pointer;
    white-space:nowrap;
}

.category.active{
    background:#111827;
    color:white;
}

/* PRODUCTS */
.products{
    display:grid;
    grid-template-columns:
        repeat(4,1fr);
    gap:20px;
}

.card{
    background:white;
    border-radius:16px;
    overflow:hidden;
    box-shadow:
        0 5px 20px rgba(0,0,0,.08);
    transition:.2s;
}

.card:hover{
    transform:translateY(-5px);
}

.card img{
    width:100%;
    height:220px;
    object-fit:cover;
}

.card-body{
    padding:15px;
}

.card h3{
    margin-bottom:8px;
}

.price{
    font-size:19px;
    font-weight:bold;
    margin:10px 0;
}

.stock{
    font-size:13px;
    color:#6b7280;
    margin-bottom:12px;
}

.btn{
    width:100%;
    border:0;
    border-radius:9px;
    padding:11px;
    background:#111827;
    color:white;
    cursor:pointer;
}

.btn:hover{
    background:#374151;
}

/* CART */
.overlay{
    display:none;
    position:fixed;
    inset:0;
    background:rgba(0,0,0,.55);
    z-index:150;
}

.overlay.show{
    display:block;
}

.cart{
    position:fixed;
    right:-420px;
    top:0;
    width:390px;
    max-width:90%;
    height:100%;
    background:white;
    z-index:200;

    padding:22px;

    box-shadow:
        -5px 0 20px rgba(0,0,0,.25);

    transition:.3s;
    overflow-y:auto;
}

.cart.open{
    right:0;
}

.cart-header{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:20px;
}

.close{
    border:0;
    background:#eee;
    padding:8px 12px;
    border-radius:8px;
    cursor:pointer;
}

.cart-item{
    display:flex;
    gap:10px;
    padding:12px 0;
    border-bottom:1px solid #eee;
}

.cart-item img{
    width:65px;
    height:65px;
    border-radius:9px;
    object-fit:cover;
}

.cart-info{
    flex:1;
}

.qty{
    display:flex;
    align-items:center;
    gap:8px;
    margin-top:8px;
}

.qty button{
    border:0;
    padding:5px 10px;
    border-radius:6px;
    cursor:pointer;
}

.total{
    font-size:21px;
    font-weight:bold;
    margin:22px 0;
}

.checkout{
    background:#7c3aed;
}

.checkout:hover{
    background:#6d28d9;
}

.empty{
    text-align:center;
    padding:40px 0;
    color:#777;
}

/* FOOTER */
footer{
    text-align:center;
    padding:35px;
    color:#6b7280;
}

/* RESPONSIVE */
@media(max-width:900px){

    .products{
        grid-template-columns:
            repeat(2,1fr);
    }

    .hero img{
        width:220px;
    }
}

@media(max-width:600px){

    .nav{
        flex-wrap:wrap;
    }

    .logo{
        margin-right:auto;
    }

    .search{
        order:3;
        flex-basis:100%;
        max-width:none;
    }

    .hero{
        margin:15px;
        padding:30px 22px;
    }

    .hero h1{
        font-size:30px;
    }

    .hero img{
        display:none;
    }

    .products{
        grid-template-columns:
            repeat(2,1fr);
        gap:12px;
    }

    .card img{
        height:165px;
    }

    .card-body{
        padding:11px;
    }

    .card h3{
        font-size:15px;
    }

    .price{
        font-size:16px;
    }
}
</style>
</head>

<body>

<!-- NAVBAR -->
<header>

<div class="nav">

<div class="logo">
🛍️ CessaShop
</div>

<input
    type="text"
    id="search"
    class="search"
    placeholder="🔎 Cari produk..."
>

<button
    class="cart-button"
    onclick="openCart()"
>
🛒 Keranjang
(<span id="cartCount">0</span>)
</button>

</div>

</header>


<!-- HERO -->
<section class="hero">

<div>

<h1>
Belanja Jadi Lebih Mudah
</h1>

<p>
Temukan berbagai produk favoritmu
dengan harga menarik dan checkout
dengan cepat.
</p>

</div>

<img
src="https://images.unsplash.com/photo-1441986300917-64674bd600d8?auto=format&fit=crop&w=700&q=80"
alt="Online Shop"
>

</section>


<!-- CONTENT -->
<main class="container">

<h2 class="section-title">
Kategori
</h2>

<div class="categories">

<button
class="category active"
onclick="filterCategory('Semua',this)"
>
Semua
</button>

<button
class="category"
onclick="filterCategory('Fashion',this)"
>
Fashion
</button>

<button
class="category"
onclick="filterCategory('Sepatu',this)"
>
Sepatu
</button>

<button
class="category"
onclick="filterCategory('Aksesoris',this)"
>
Aksesoris
</button>

</div>


<h2 class="section-title">
Produk Terbaru
</h2>

<div
class="products"
id="products"
></div>

</main>


<!-- OVERLAY -->
<div
id="overlay"
class="overlay"
onclick="closeCart()"
></div>


<!-- CART -->
<aside
id="cart"
class="cart"
>

<div class="cart-header">

<h2>
🛒 Keranjang
</h2>

<button
class="close"
onclick="closeCart()"
>
✕
</button>

</div>

<div id="cartItems"></div>

<div class="total">

Total:
<span id="cartTotal">
Rp 0
</span>

</div>

<button
class="btn checkout"
onclick="checkout()"
>
Checkout
</button>

</aside>


<footer>

© 2026 CessaShop
<br>
Online Shop Demo

</footer>


<script>

/* =========================
   DATA PRODUK
========================= */

const products = [

{
id:1,
name:"Hoodie Premium",
category:"Fashion",
price:175000,
stock:12,
img:"https://images.unsplash.com/photo-1556821840-3a63f95609a7?auto=format&fit=crop&w=700&q=80"
},

{
id:2,
name:"Kaos Basic",
category:"Fashion",
price:75000,
stock:20,
img:"https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?auto=format&fit=crop&w=700&q=80"
},

{
id:3,
name:"Sneakers Casual",
category:"Sepatu",
price:299000,
stock:8,
img:"https://images.unsplash.com/photo-1542291026-7eec264c27ff?auto=format&fit=crop&w=700&q=80"
},

{
id:4,
name:"Tas Selempang",
category:"Aksesoris",
price:95000,
stock:15,
img:"https://images.unsplash.com/photo-1553062407-98eeb64c6a62?auto=format&fit=crop&w=700&q=80"
},

{
id:5,
name:"Topi Casual",
category:"Aksesoris",
price:55000,
stock:18,
img:"https://images.unsplash.com/photo-1521369909029-2afed882baee?auto=format&fit=crop&w=700&q=80"
},

{
id:6,
name:"Jaket Denim",
category:"Fashion",
price:225000,
stock:10,
img:"https://images.unsplash.com/photo-1543076447-215ad9ba6923?auto=format&fit=crop&w=700&q=80"
},

{
id:7,
name:"Running Shoes",
category:"Sepatu",
price:325000,
stock:7,
img:"https://images.unsplash.com/photo-1551107696-a4b0c5a0d9a2?auto=format&fit=crop&w=700&q=80"
},

{
id:8,
name:"Jam Tangan",
category:"Aksesoris",
price:185000,
stock:9,
img:"https://images.unsplash.com/photo-1524805444758-089113d48a6d?auto=format&fit=crop&w=700&q=80"
}

];


/* =========================
   KERANJANG
========================= */

let cart =
JSON.parse(
localStorage.getItem("cessashop_cart")
|| "[]"
);

let currentCategory = "Semua";


/* FORMAT RUPIAH */

function rupiah(number){

return new Intl.NumberFormat(
"id-ID",
{
style:"currency",
currency:"IDR",
maximumFractionDigits:0
}
).format(number);

}


/* SIMPAN CART */

function saveCart(){

localStorage.setItem(
"cessashop_cart",
JSON.stringify(cart)
);

}


/* =========================
   PRODUK
========================= */

function renderProducts(){

const search =
document
.getElementById("search")
.value
.toLowerCase();

const list =
products.filter(product => {

const categoryMatch =
currentCategory === "Semua"
||
product.category === currentCategory;

const searchMatch =
product.name
.toLowerCase()
.includes(search);

return categoryMatch && searchMatch;

});


document.getElementById("products")
.innerHTML = list.map(product => `

<article class="card">

<img
src="${product.img}"
alt="${product.name}"
>

<div class="card-body">

<h3>
${product.name}
</h3>

<div class="price">
${rupiah(product.price)}
</div>

<div class="stock">
Stok tersedia:
${product.stock}
</div>

<button
class="btn"
onclick="addCart(${product.id})"
>

Tambah ke Keranjang

</button>

</div>

</article>

`).join("");

}


/* =========================
   FILTER
========================= */

function filterCategory(category,element){

currentCategory = category;

document
.querySelectorAll(".category")
.forEach(button => {

button.classList.remove("active");

});

element.classList.add("active");

renderProducts();

}


/* =========================
   ADD CART
========================= */

function addCart(id){

const product =
products.find(
product => product.id === id
);

const item =
cart.find(
item => item.id === id
);


if(item){

if(item.qty < product.stock){

item.qty++;

}

}else{

cart.push({
id:id,
qty:1
});

}


saveCart();

renderCart();

openCart();

}


/* =========================
   UBAH JUMLAH
========================= */

function changeQty(id,change){

const item =
cart.find(
item => item.id === id
);

const product =
products.find(
product => product.id === id
);

if(!item)return;


item.qty += change;


if(item.qty <= 0){

cart =
cart.filter(
item => item.id !== id
);

}


if(item.qty > product.stock){

item.qty =
product.stock;

}


saveCart();

renderCart();

}


/* =========================
   RENDER CART
========================= */

function renderCart(){

let total = 0;

let count = 0;

const box =
document.getElementById(
"cartItems"
);


if(cart.length === 0){

box.innerHTML = `

<div class="empty">

Keranjang masih kosong 🛒

</div>

`;

}else{

box.innerHTML = cart.map(item => {

const product =
products.find(
product =>
product.id === item.id
);

const subtotal =
product.price * item.qty;

total += subtotal;

count += item.qty;


return `

<div class="cart-item">

<img
src="${product.img}"
alt="${product.name}"
>

<div class="cart-info">

<b>
${product.name}
</b>

<div>
${rupiah(product.price)}
</div>

<div class="qty">

<button
onclick="changeQty(${product.id},-1)"
>
−
</button>

<span>
${item.qty}
</span>

<button
onclick="changeQty(${product.id},1)"
>
+
</button>

</div>

</div>

</div>

`;

}).join("");

}


document.getElementById(
"cartTotal"
).textContent =
rupiah(total);


document.getElementById(
"cartCount"
).textContent =
count;

}


/* =========================
   OPEN CART
========================= */

function openCart(){

document
.getElementById("cart")
.classList.add("open");

document
.getElementById("overlay")
.classList.add("show");

}


/* CLOSE CART */

function closeCart(){

document
.getElementById("cart")
.classList.remove("open");

document
.getElementById("overlay")
.classList.remove("show");

}


/* =========================
   CHECKOUT
========================= */

function checkout(){

if(cart.length === 0){

alert(
"Keranjang masih kosong!"
);

return;

}


const name =
prompt(
"Masukkan nama penerima:"
);

if(!name)return;


const address =
prompt(
"Masukkan alamat pengiriman:"
);

if(!address)return;


let total = 0;


cart.forEach(item => {

const product =
products.find(
product =>
product.id === item.id
);

total +=
product.price *
item.qty;

});


alert(

"✅ PESANAN BERHASIL\n\n"
+
"Nama: "
+
name
+
"\nAlamat: "
+
address
+
"\nTotal: "
+
rupiah(total)

);


cart = [];

saveCart();

renderCart();

closeCart();

}


/* =========================
   SEARCH
========================= */

document
.getElementById("search")
.addEventListener(
"input",
renderProducts
);


/* =========================
   START
========================= */

renderProducts();

renderCart();

</script>

</body>
</html>